###############################################################################
# cloud-init for the Go monolith CVMs. Variables are injected by templatefile()
# in main.tf. This is a staging bootstrap; production uses an immutable baked
# image (Packer) and pulls the binary by SHA, not curl latest.
###############################################################################

#cloud-config
package_update: true
packages:
  - docker.io
  - docker-compose-plugin

write_files:
  - path: /opt/zgjs/.env
    owner: root:root
    mode: "0600"
    content: |
      ZG_ENV=${env}
      ZG_POSTGRES_HOST=${mysql_host}
      ZG_POSTGRES_PASSWORD=${mysql_password}
      ZG_REDIS_HOST=${redis_host}
      ZG_REDIS_PASSWORD=${redis_password}
      ZG_COS_BUCKET=${cos_bucket}

runcmd:
  - systemctl enable --now docker
  - docker run -d --restart=always --name zgjs-api \
      --env-file /opt/zgjs/.env \
      -p 8080:8080 \
      registry.example.com/zhangguijunshi/backend:latest
