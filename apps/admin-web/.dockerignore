# .dockerignore — 排除不必进入 builder 镜像的本地文件
# (依赖会在容器内 npm ci 重建; 构建产物在 builder 内重新生成)

node_modules
dist
dist-ssr
.vite
*.tsbuildinfo

# 版本控制 / CI 元数据
.git
.gitignore
.github
.gitlab-ci.yml

# 本地 IDE / 系统
.idea
.vscode
.DS_Store

# 本地环境与日志
.env
.env.*
*.local
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 已有容器化产物自身 (避免递归)。注意: nginx.conf 不在此列——runtime 阶段
# COPY nginx.conf 到镜像内, 必须保留在构建上下文里。
Dockerfile
.dockerignore
