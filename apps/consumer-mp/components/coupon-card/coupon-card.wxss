/* components/coupon-card/coupon-card.wxss — 券卡片组件 */
/* 全局已定义 .coupon-item / .coupon-value / .coupon-title / .coupon-meta / .coupon-status-* */
.coupon-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.coupon-status {
  margin-top: 8rpx;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
}
.coupon-right {
  flex: 1;
  min-width: 0;
}
