/* pages/join/join.wxss — 领券入会转化页 (复用 app.wxss btn-primary, 本页补转化区布局) */

/* 新人专享券大图 (色块占位) */
.join-coupon {
  background: linear-gradient(135deg, #FF6B35 0%, #FFB627 100%);
  border-radius: 20rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  color: #FFFFFF;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.25);
}
.join-coupon-value {
  font-size: 96rpx;
  font-weight: 700;
  line-height: 1.1;
}
.join-coupon-label {
  font-size: 36rpx;
  font-weight: 600;
  margin-top: 8rpx;
}
.join-coupon-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}

/* 会员权益 3 条 */
.join-benefits {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.08);
}
.join-benefit-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #FFF0E8;
}
.join-benefit-item:last-child {
  border-bottom: none;
}
.join-benefit-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}
.join-benefit-text {
  font-size: 30rpx;
  color: #1F1F1F;
}

/* 隐私同意行 */
.join-agree {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
  padding: 0 8rpx;
}
.join-agree-checkbox {
  transform: scale(0.8);
  margin-right: 4rpx;
}
.join-agree-text {
  font-size: 26rpx;
  color: #8C8C8C;
}
.join-agree-link {
  font-size: 26rpx;
  color: #FF6B35;
}

/* 授权按钮 */
.join-submit {
  margin-bottom: 40rpx;
}

/* 成功态 */
.join-success {
  text-align: center;
  padding: 120rpx 40rpx;
}
.join-success-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}
.join-success-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F1F1F;
  margin-bottom: 12rpx;
}
.join-success-sub {
  font-size: 28rpx;
  color: #8C8C8C;
  margin-bottom: 48rpx;
}
.join-success-btn {
  margin-bottom: 24rpx;
}
.join-link-btn {
  background: none;
  color: #FF6B35;
  font-size: 30rpx;
  border: none;
}
.join-link-btn::after {
  border: none;
}
