/* pages/group-buy-detail/group-buy-detail.wxss — 拼团详情页特有布局 */
.gb-detail-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FFB627 100%);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.25);
}
.gb-detail-status {
  display: inline-block;
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.gb-detail-title {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.4;
  margin-bottom: 16rpx;
}
.gb-detail-price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 16rpx;
}
.gb-detail-price {
  font-size: 56rpx;
  font-weight: 700;
}
.gb-detail-original {
  font-size: 30rpx;
  text-decoration: line-through;
  opacity: 0.7;
  margin-left: 12rpx;
}
.gb-detail-desc {
  font-size: 26rpx;
  opacity: 0.92;
  line-height: 1.5;
}
.gb-progress {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.gb-progress-bar {
  flex: 1;
  height: 16rpx;
  background: #F0E6DE;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 16rpx;
}
.gb-progress-inner {
  height: 100%;
  background: linear-gradient(90deg, #FF6B35 0%, #FFB627 100%);
  border-radius: 8rpx;
  transition: width 0.3s;
}
.gb-progress-text {
  font-size: 28rpx;
  color: #FF6B35;
  font-weight: 600;
  white-space: nowrap;
}
.gb-detail-meta {
  font-size: 24rpx;
  color: #8C8C8C;
  margin-top: 16rpx;
}
.gb-detail-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}
.gb-detail-row-label {
  font-size: 28rpx;
  color: #8C8C8C;
}
.gb-detail-row-val {
  font-size: 28rpx;
  color: #1F1F1F;
}
.gb-detail-footer {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}
.gb-join-btn {
  width: 100%;
}
