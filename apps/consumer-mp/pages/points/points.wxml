<!-- pages/points/points.wxml — 积分明细 -->
<view class="container">
  <!-- 未登录态 -->
  <view wx:if="{{!isLoggedIn}}" class="empty">
    <view class="empty-icon">🔒</view>
    <view>请先登录</view>
    <button class="btn-primary" style="margin-top:40rpx;width:300rpx;" bindtap="onTapLogin">去登录</button>
  </view>

  <block wx:else>
    <!-- 顶部积分卡 (渐变橙金) -->
    <view class="member-header">
      <view class="points-label">当前可用积分</view>
      <view class="points-num">{{points}}</view>
    </view>

    <block wx:if="{{loading}}">
      <view class="loading">加载中…</view>
    </block>

    <block wx:elif="{{groups.length}}">
      <view
        wx:for="{{groups}}"
        wx:key="date"
        wx:for-item="grp"
        class="points-day"
      >
        <view class="points-day-title">{{grp.date}}</view>
        <view class="points-day-body">
          <view
            wx:for="{{grp.logs}}"
            wx:for-item="log"
            wx:key="key"
            class="points-log"
          >
            <view class="points-log-left">
              <view class="points-log-type">{{log.typeText}}</view>
              <view class="points-log-time">{{log.created}}</view>
            </view>
            <view class="points-log-right">
              <view class="{{log.deltaCls}}">{{log.deltaText}}</view>
              <view class="points-log-after">余额 {{log.pointsAfter}}</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <empty-state wx:else icon="⭐" text="暂无积分明细"/>
  </block>
</view>
