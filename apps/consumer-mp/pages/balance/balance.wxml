<!-- pages/balance/balance.wxml — 储值余额 -->
<view class="container">
  <!-- 未登录态 -->
  <view wx:if="{{!isLoggedIn}}" class="empty">
    <view class="empty-icon">🔒</view>
    <view>请先登录</view>
    <button class="btn-primary login-btn" bindtap="onTapLogin">去登录</button>
  </view>

  <block wx:else>
    <!-- 余额卡片 (渐变橙金, 复用 profile 会员卡风格) -->
    <view class="member-header">
      <view class="grade-badge">{{levelName}}</view>
      <view class="balance-total-label">储值余额合计 (元)</view>
      <view class="balance-total-num">¥{{totalYuan}}</view>
      <view class="balance-split">
        <view class="balance-split-item">
          <view class="balance-split-num">¥{{balanceYuan}}</view>
          <view class="balance-split-label">本金</view>
        </view>
        <view class="balance-split-divider"/>
        <view class="balance-split-item">
          <view class="balance-split-num">¥{{giftYuan}}</view>
          <view class="balance-split-label">赠送</view>
        </view>
      </view>
    </view>

    <!-- 储值说明 -->
    <view class="section">
      <view class="section-title">储值说明</view>
      <view class="section-body balance-tips">
        <view class="balance-tip">· 储值余额可在收银台出示会员码直接抵扣消费金额。</view>
        <view class="balance-tip">· 本金为实际充值金额，赠送为门店活动赠送金额。</view>
        <view class="balance-tip">· 余额以分(cent)为单位精确计费，多退少补。</view>
      </view>
    </view>

    <!-- 充值入口 (CONTRACT §24.4, Simulate 直接入账) -->
    <button class="btn-primary recharge-btn" bindtap="onTapRecharge">充值</button>

    <!-- 充值金额面板 (展开式, 不新建独立页) -->
    <view wx:if="{{rechargeOpen}}" class="section recharge-panel">
      <view class="section-title">选择充值金额 (元)</view>

      <!-- 预设档位 -->
      <view class="recharge-presets">
        <view
          class="recharge-preset {{amountText === '50' ? 'recharge-preset-active' : ''}}"
          data-amt="50"
          bindtap="onTapPreset"
        >¥50</view>
        <view
          class="recharge-preset {{amountText === '100' ? 'recharge-preset-active' : ''}}"
          data-amt="100"
          bindtap="onTapPreset"
        >¥100</view>
        <view
          class="recharge-preset {{amountText === '200' ? 'recharge-preset-active' : ''}}"
          data-amt="200"
          bindtap="onTapPreset"
        >¥200</view>
      </view>

      <!-- 自定义金额 -->
      <view class="recharge-input-row">
        <text class="recharge-input-prefix">¥</text>
        <input
          class="recharge-input"
          type="digit"
          placeholder="自定义金额"
          value="{{amountText}}"
          bindinput="onAmountInput"
        />
      </view>

      <!-- 操作按钮 -->
      <view class="recharge-actions">
        <button class="recharge-btn-cancel" bindtap="onTapCancelRecharge">取消</button>
        <button
          class="btn-primary recharge-btn-confirm"
          disabled="{{submitting}}"
          bindtap="onConfirmRecharge"
        >{{submitting ? '充值中...' : '确认充值'}}</button>
      </view>
    </view>
  </block>
</view>
