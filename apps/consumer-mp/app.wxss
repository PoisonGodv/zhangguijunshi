/* app.wxss — 消费者端全局样式 (暖色零售主题,参考技术方案 §9.2 ui-tokens)
   主橙 #FF6B35 / 背景 #FFF9F5 / 辅黄 #FFB627 / 成功绿 #2ECC71 / 警示红 #FF4D4F
   基础 class 沿用 merchant-mp;下方为 C 端独有 (其余 agent 复用,命名一字不差) */

page {
  background-color: #FFF9F5;
  color: #1F1F1F;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 30rpx;
  line-height: 1.45;
}

.container {
  padding: 24rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.section {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.08);
}
.section-title {
  font-size: 24rpx;
  color: #8C8C8C;
  margin-bottom: 8rpx;
}
.section-body {
  font-size: 30rpx;
  color: #1F1F1F;
  word-break: break-all;
}

.footer {
  margin-top: 32rpx;
  padding-bottom: 40rpx;
}

/* === 主按钮 === */
.btn-primary {
  background: #FF6B35;
  color: #FFFFFF;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}
.btn-primary[disabled] {
  background: #CCCCCC;
  color: #FFFFFF;
}
.btn-primary::after { border: none; }

/* === 空状态 / 加载态 === */
.empty {
  text-align: center;
  padding: 200rpx 0;
  color: #8C8C8C;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.loading {
  text-align: center;
  padding: 80rpx 0;
  color: #8C8C8C;
}

/* ============================================================
   C 端独有 class (其余 agent 复用,命名一字不差)
   ============================================================ */

/* === 首页顶部领券卡 (橙底渐变) === */
.hero {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8855 100%);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.25);
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 8rpx;
}
.hero-sub {
  font-size: 28rpx;
  opacity: 0.92;
  margin-bottom: 24rpx;
}
.hero-cta {
  display: inline-block;
  background: #FFFFFF;
  color: #FF6B35;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 16rpx 40rpx;
}
.hero-cta::after { border: none; }

/* === 福利卡 (首页今日福利) === */
.benefit-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.08);
}
.benefit-tag {
  display: inline-block;
  background: #FF6B35;
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}
.benefit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-bottom: 8rpx;
}
.benefit-desc {
  font-size: 28rpx;
  color: #8C8C8C;
  line-height: 1.5;
}

/* === 门店卡片 === */
.store-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.08);
}
.store-row {
  display: flex;
  align-items: flex-start;
}
.store-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-bottom: 8rpx;
}
.store-addr {
  font-size: 26rpx;
  color: #8C8C8C;
  line-height: 1.5;
}

/* === 我的页九宫格菜单 === */
.entry-grid {
  display: flex;
  flex-wrap: wrap;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.08);
}
.entry-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
}
.entry-icon {
  font-size: 52rpx;
  margin-bottom: 8rpx;
}
.entry-label {
  font-size: 26rpx;
  color: #1F1F1F;
}

/* === 我的页会员卡 (渐变橙金) === */
.member-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FFB627 100%);
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  color: #FFFFFF;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 182, 39, 0.25);
}
.grade-badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.25);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.stat-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.2;
}
.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

/* === 券卡 (左侧大额,右侧信息) === */
.coupon-item {
  display: flex;
  align-items: stretch;
  background: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.08);
}
.coupon-value {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8855 100%);
  color: #FFFFFF;
  width: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
}
.coupon-meta {
  flex: 1;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.coupon-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-bottom: 8rpx;
}
.coupon-status-unused {
  font-size: 24rpx;
  color: #FF6B35;
}
.coupon-status-used {
  font-size: 24rpx;
  color: #8C8C8C;
}
.coupon-status-expired {
  font-size: 24rpx;
  color: #BFBFBF;
}

/* === 会员码二维码框 === */
.qr-box {
  position: relative;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(255, 107, 53, 0.12);
}
.qr-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #FF6B35;
}
.qr-tip {
  text-align: center;
  font-size: 28rpx;
  color: #8C8C8C;
  margin-bottom: 32rpx;
}

/* === 券包三 tab === */
.tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.08);
}
.tab {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  color: #8C8C8C;
  padding: 16rpx 0;
  border-radius: 12rpx;
}
.tab-active {
  color: #FFFFFF;
  background: #FF6B35;
  font-weight: 600;
}

/* === 价格 / 角标 === */
.price-now {
  color: #FF4D4F;
  font-weight: 700;
}
.price-old {
  color: #BFBFBF;
  text-decoration: line-through;
  margin-left: 8rpx;
}
.badge-dot {
  display: inline-block;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #FF4D4F;
  color: #FFFFFF;
  font-size: 22rpx;
}
