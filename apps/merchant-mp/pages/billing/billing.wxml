<!-- pages/billing/billing.wxml — 开单页 -->
<view class="container billing-container">

  <!-- === 回执态 (收款成功后覆盖整页) === -->
  <block wx:if="{{receipt}}">
    <view class="receipt-card">
      <view class="receipt-icon">✅</view>
      <view class="receipt-title">收款成功</view>
      <view class="receipt-amount">¥{{receipt.total_yuan}}</view>
      <view class="receipt-row">
        <text class="receipt-label">订单号</text>
        <text class="receipt-value">{{receipt.order_no}}</text>
      </view>
      <view class="receipt-row">
        <text class="receipt-label">商品件数</text>
        <text class="receipt-value">{{receipt.count}} 件</text>
      </view>
      <view class="receipt-row">
        <text class="receipt-label">收款时间</text>
        <text class="receipt-value">{{receipt.paid_at}}</text>
      </view>
    </view>
    <view class="footer">
      <button class="btn-primary" bindtap="onNewOrder">再开一单</button>
    </view>
  </block>

  <!-- === 开单态 === -->
  <block wx:else>

    <!-- 搜索 + 扫码 -->
    <view class="search-row">
      <view class="search-box">
        <text class="search-icon">🔍</text>
        <input
          class="search-input"
          placeholder="搜索商品名称/条码"
          placeholder-class="search-input-ph"
          value="{{keyword}}"
          bindinput="onKeywordInput"
          confirm-type="search"
        />
        <text wx:if="{{keyword}}" class="search-clear" bindtap="onKeywordClear">✕</text>
      </view>
      <button class="btn-scan" loading="{{scanning}}" bindtap="onScan">扫码</button>
    </view>

    <!-- 商品列表 -->
    <view class="section product-section">
      <view class="section-title">商品 (点 + 加入购物车)</view>
      <block wx:if="{{products.length}}">
        <view
          wx:for="{{products}}"
          wx:key="ID"
          class="product-row"
        >
          <view class="product-info">
            <view class="product-name">{{item.Name}}</view>
            <view class="product-meta">
              <text class="product-price">¥{{item.price_yuan}}</text>
              <text wx:if="{{item.Unit}}" class="product-unit">/ {{item.Unit}}</text>
              <text wx:if="{{item.Barcode}}" class="product-barcode">码 {{item.Barcode}}</text>
            </view>
          </view>
          <view class="product-add" data-id="{{item.ID}}" catchtap="onAddProduct">+</view>
        </view>
        <view wx:if="{{listLoading}}" class="list-tip">加载中…</view>
        <view wx:elif="{{listFinished}}" class="list-tip">已加载全部</view>
      </block>
      <view wx:elif="{{listLoading}}" class="list-tip">加载中…</view>
      <view wx:else class="empty">
        <view class="empty-icon">🛍️</view>
        <view>暂无商品,去后台录一个?</view>
      </view>
    </view>

    <!-- 购物车 -->
    <view class="section cart-section" wx:if="{{cart.length}}">
      <view class="cart-header">
        <view class="section-title">购物车 ({{totalCount}} 件)</view>
        <view class="cart-clear" bindtap="onClearCart">清空</view>
      </view>
      <view
        wx:for="{{cart}}"
        wx:key="product_id"
        class="cart-row"
      >
        <view class="cart-info">
          <view class="cart-name">{{item.name}}</view>
          <view class="cart-price">¥{{item.price_yuan}}<text wx:if="{{item.unit}}" class="cart-unit">/{{item.unit}}</text></view>
        </view>
        <view class="cart-ops">
          <view class="step-btn" data-id="{{item.product_id}}" catchtap="onDec">−</view>
          <view class="step-qty">{{item.qty}}</view>
          <view class="step-btn" data-id="{{item.product_id}}" catchtap="onInc">+</view>
        </view>
        <view class="cart-subtotal">¥{{item.subtotal_yuan}}</view>
        <view class="cart-remove" data-id="{{item.product_id}}" catchtap="onRemoveLine">✕</view>
      </view>
    </view>

    <!-- 底部合计 + 开单按钮 -->
    <view class="billing-footer">
      <view class="total-box">
        <view class="total-count">共 {{totalCount}} 件</view>
        <view class="total-amount">¥{{totalYuan}}</view>
      </view>
      <button
        class="btn-primary btn-submit"
        loading="{{submitting}}"
        disabled="{{!cart.length || submitting}}"
        bindtap="onSubmit"
      >开单</button>
    </view>

    <!-- 占位: 给底部固定栏留空间 -->
    <view class="footer-spacer"></view>
  </block>
</view>
