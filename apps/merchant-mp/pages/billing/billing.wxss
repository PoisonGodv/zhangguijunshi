/* pages/billing/billing.wxss — 开单页样式 (暖色主题 #FF6B35, 沿用 app.wxss 卡片/按钮) */

.billing-container {
  padding-bottom: 40rpx;
}

/* === 搜索 + 扫码 === */
.search-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 44rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 53, 0.06);
}
.search-icon {
  font-size: 28rpx;
  color: #8C8C8C;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1F1F1F;
}
.search-input-ph {
  color: #BFBFBF;
}
.search-clear {
  padding: 8rpx 12rpx;
  font-size: 24rpx;
  color: #BFBFBF;
}
.btn-scan {
  margin-left: 16rpx;
  flex-shrink: 0;
  width: 144rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #FFFFFF;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
}
.btn-scan::after { border: none; }

/* === 商品列表 === */
.product-section {
  padding: 16rpx 0;
}
.product-section .section-title {
  padding: 0 24rpx 12rpx;
}
.product-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.product-row:last-child {
  border-bottom: none;
}
.product-info {
  flex: 1;
  min-width: 0;
}
.product-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1F1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.product-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8C8C8C;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}
.product-price {
  color: #FF6B35;
  font-weight: 600;
  font-size: 28rpx;
}
.product-unit {
  margin-left: 4rpx;
}
.product-barcode {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #BFBFBF;
}
.product-add {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  background: #FF6B35;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 40rpx;
  font-weight: 600;
}
.product-add:active {
  opacity: 0.8;
}

.list-tip {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #BFBFBF;
}

/* === 购物车 === */
.cart-section {
  padding: 16rpx 0;
  margin-bottom: 24rpx;
}
.cart-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx 12rpx;
}
.cart-clear {
  font-size: 24rpx;
  color: #8C8C8C;
  padding: 4rpx 12rpx;
}
.cart-row {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.cart-row:last-child {
  border-bottom: none;
}
.cart-info {
  flex: 1;
  min-width: 0;
}
.cart-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1F1F;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.cart-price {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #FF6B35;
}
.cart-unit {
  color: #BFBFBF;
  margin-left: 2rpx;
}
.cart-ops {
  display: flex;
  align-items: center;
  margin: 0 16rpx;
  flex-shrink: 0;
}
.step-btn {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border: 2rpx solid #FF6B35;
  color: #FF6B35;
  border-radius: 50%;
  font-size: 32rpx;
  font-weight: 600;
  background: #FFFFFF;
}
.step-btn:active {
  background: #FFF3EC;
}
.step-qty {
  min-width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1F1F;
}
.cart-subtotal {
  width: 140rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
  color: #1F1F1F;
  flex-shrink: 0;
}
.cart-remove {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 8rpx 12rpx;
  color: #BFBFBF;
  font-size: 28rpx;
}
.cart-remove:active {
  color: #FF4D4F;
}

/* === 底部合计 + 开单 === */
.billing-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}
.total-box {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.total-count {
  font-size: 24rpx;
  color: #8C8C8C;
}
.total-amount {
  font-size: 44rpx;
  font-weight: 700;
  color: #FF6B35;
  line-height: 1.2;
}
.btn-submit {
  flex-shrink: 0;
  width: 240rpx;
  margin: 0;
}
.footer-spacer {
  height: 160rpx;
}

/* === 回执 === */
.receipt-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  margin-top: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.08);
  text-align: center;
}
.receipt-icon {
  font-size: 96rpx;
  margin-bottom: 12rpx;
}
.receipt-title {
  font-size: 32rpx;
  color: #2ECC71;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.receipt-amount {
  font-size: 72rpx;
  font-weight: 700;
  color: #FF6B35;
  margin-bottom: 32rpx;
  line-height: 1.2;
}
.receipt-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-top: 1rpx dashed #F0F0F0;
}
.receipt-label {
  color: #8C8C8C;
}
.receipt-value {
  color: #1F1F1F;
  font-weight: 500;
}
