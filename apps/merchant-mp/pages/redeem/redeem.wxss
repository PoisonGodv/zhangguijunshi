/* pages/redeem/redeem.wxss — 会员码核销页 (暖色主题 #FF6B35, 沿用 app.wxss 卡片/按钮/输入框) */

.redeem-container {
  padding-bottom: 40rpx;
}

/* === 会员码: 输入 + 扫码 === */
.code-row {
  display: flex;
  align-items: center;
}
.code-input {
  flex: 1;
  height: 88rpx;
  background: #FFF9F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1F1F1F;
}
.btn-scan {
  margin-left: 16rpx;
  flex-shrink: 0;
  width: 144rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #FFFFFF;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
}
.btn-scan::after { border: none; }

/* === 金额/积分输入 === */
.field-row {
  display: flex;
  align-items: center;
  background: #FFF9F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 96rpx;
}
.field-currency {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-right: 12rpx;
}
.field-input {
  flex: 1;
  height: 96rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #1F1F1F;
}
.field-unit {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #8C8C8C;
  margin-left: 12rpx;
}
.field-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #BFBFBF;
}

.search-input-ph {
  color: #BFBFBF;
}

/* === 底部确认 === */
.redeem-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}
.btn-block {
  flex: 1;
  width: 100%;
  margin: 0;
}
.footer-spacer {
  height: 160rpx;
}

/* === 回执 (对齐 billing/recharge) === */
.receipt-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  margin-top: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.08);
  text-align: center;
}
.receipt-icon {
  font-size: 96rpx;
  margin-bottom: 12rpx;
}
.receipt-title {
  font-size: 32rpx;
  color: #2ECC71;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.receipt-amount {
  font-size: 72rpx;
  font-weight: 700;
  color: #FF6B35;
  margin-bottom: 32rpx;
  line-height: 1.2;
}
.receipt-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-top: 1rpx dashed #F0F0F0;
}
.receipt-label {
  color: #8C8C8C;
}
.receipt-value {
  color: #1F1F1F;
  font-weight: 500;
}
.receipt-total {
  color: #FF6B35;
  font-weight: 600;
}
.receipt-note {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #BFBFBF;
}
