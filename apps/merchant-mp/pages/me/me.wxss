/* pages/me/me.wxss — 「我的」页样式 (暖色系,对齐 app.wxss) */

/* === 头部: 门店/身份卡 === */
.me-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C5A 100%);
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  color: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.18);
}

.me-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.me-header-main {
  flex: 1;
  min-width: 0;
}

.me-store-name {
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
  margin-bottom: 6rpx;
}

.me-store-id {
  font-size: 24rpx;
  opacity: 0.9;
}

/* === 今日经营 2x2 网格 === */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx -8rpx -8rpx;
}

.stat-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 20rpx 8rpx;
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 600;
  color: #1F1F1F;
  line-height: 1.2;
  word-break: break-all;
}

.stat-label {
  font-size: 24rpx;
  color: #8C8C8C;
  margin-top: 8rpx;
}

/* === 订阅卡 === */
.sub-row {
  display: flex;
  align-items: center;
}

.sub-main {
  flex: 1;
  min-width: 0;
}

.sub-plan {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.sub-plan-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F1F1F;
  margin-right: 12rpx;
}

.sub-status {
  font-size: 22rpx;
  color: #2ECC71;
  border: 1rpx solid #2ECC71;
  border-radius: 16rpx;
  padding: 2rpx 12rpx;
}

.sub-expire {
  font-size: 24rpx;
  color: #8C8C8C;
}

.sub-upgrade {
  flex-shrink: 0;
  background: #FF6B35;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
}

.sub-upgrade:active {
  opacity: 0.85;
}

/* === 功能区菜单 === */
.menu-list {
  /* section 已有 padding/margin */
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  opacity: 0.7;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  width: 48rpx;
  text-align: center;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #1F1F1F;
}

.menu-item-danger .menu-text {
  color: #FF4D4F;
}

.menu-arrow {
  font-size: 32rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
  flex-shrink: 0;
}
