<!-- pages/login/login.wxml — 老板登录页 -->
<view class="container login-container">
  <!-- 顶部品牌区 -->
  <view class="login-brand">
    <view class="login-title">掌柜军师</view>
    <view class="login-subtitle">老板的 AI 营销军师</view>
  </view>

  <!-- 登录表单卡片 -->
  <view class="section login-card">
    <view class="login-field">
      <view class="login-label">租户ID</view>
      <input
        class="login-input login-input-tenant"
        type="number"
        value="{{tenantId}}"
        placeholder="门店租户ID"
        bindinput="onTenantInput"
      />
    </view>
    <view class="login-field">
      <view class="login-label">手机号</view>
      <input
        class="login-input"
        type="number"
        maxlength="11"
        value="{{phone}}"
        placeholder="请输入 11 位手机号"
        bindinput="onPhoneInput"
      />
    </view>
    <view class="login-field">
      <view class="login-label">密码</view>
      <input
        class="login-input"
        password
        value="{{password}}"
        placeholder="请输入密码"
        bindinput="onPasswordInput"
      />
    </view>

    <button
      class="btn-primary login-btn"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="onSubmit"
    >登 录</button>
  </view>
</view>
