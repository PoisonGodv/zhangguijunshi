# zhanggui-junshi environment variables — PLACEHOLDER ONLY (no real secrets).
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.
# Production secrets are injected at runtime from Tencent Cloud SSM/KMS, not this file.
#
# Variable names follow the viper convention: prefix ZG_, underscore-nested by key path
# (e.g. postgres.host -> ZG_POSTGRES_HOST). See backend/pkg/config/types.go.

# ---- Runtime ----
ZG_APP_ENV=dev
ZG_APP_NAME=zhanggui-junshi-backend
ZG_APP_VERSION=0.1.0-dev

# ---- HTTP ----
ZG_HTTP_HOST=0.0.0.0
ZG_HTTP_PORT=8080

# ---- Postgres (dev uses docker compose pgvector; prod uses TDSQL-C) ----
ZG_POSTGRES_HOST=localhost
ZG_POSTGRES_PORT=5432
ZG_POSTGRES_USER=zg
ZG_POSTGRES_PASSWORD=zg
ZG_POSTGRES_DATABASE=zhanggui
ZG_POSTGRES_SSL_MODE=disable

# ---- Redis ----
ZG_REDIS_HOST=localhost
ZG_REDIS_PORT=6379
ZG_REDIS_PASSWORD=
ZG_REDIS_DB=0

# ---- Log ----
ZG_LOG_LEVEL=debug
ZG_LOG_ENCODING=console

# ---- JWT (self-signed) ----
ZG_JWT_SECRET=__FROM_SSM__
ZG_JWT_ISSUER=zhanggui-junshi

# ---- OpenTelemetry ----
ZG_OTEL_ENABLE=false
ZG_OTEL_ENDPOINT=localhost:4318
ZG_OTEL_SERVICE_NAME=zhanggui-junshi-backend
ZG_OTEL_SAMPLE_RATIO=1.0
ZG_OTEL_INSECURE=true

# ---- Tencent COS (S3-compatible object storage) ----
ZG_COS_SECRET_ID=__REPLACE__
ZG_COS_SECRET_KEY=__FROM_SSM__
ZG_COS_REGION=ap-guangzhou
ZG_COS_BUCKET=zhanggui-dev-1300000000
ZG_COS_ENDPOINT=

# ---- Multitenancy (row-level isolation guard) ----
ZG_MULTITENANCY_STRICT=true

# ============================================================
# ---- Production (docker-compose.prod.yml) ----
# ============================================================
# Copy these into your prod .env (gitignored). All prod secrets are injected at
# runtime from Tencent Cloud SSM/KMS — leave sensitive ones empty below and
# fill from your secret manager; never commit real values.
# Run: docker compose --env-file .env -f infra/compose/docker-compose.prod.yml up -d
# Migrate first: docker compose --env-file .env -f infra/compose/docker-compose.prod.yml --profile migrate up
# (also select prod config: ZG_ENV=prod is set in compose `environment:`.)

# --- App / runtime (prod) ---
ZG_APP_ENV=prod
ZG_APP_NAME=zhanggui-junshi-backend
ZG_APP_VERSION=0.1.0-prod   # inject real version at build/deploy time

# --- Postgres (compose service `postgres`; or managed TDSQL-C host) ---
# Override host to external managed DB by setting ZG_POSTGRES_HOST=<host> and
# ZG_POSTGRES_SSL_MODE=require in prod-managed deployments.
ZG_POSTGRES_HOST=postgres
ZG_POSTGRES_PORT=5432
ZG_POSTGRES_USER=zg
ZG_POSTGRES_PASSWORD=                 # from SSM/KMS — DO NOT commit
ZG_POSTGRES_DATABASE=zhanggui
ZG_POSTGRES_SSL_MODE=disable         # set `require` for managed prod DB over TLS

# --- Redis (compose service `redis`; or managed Redis host) ---
ZG_REDIS_HOST=redis
ZG_REDIS_PORT=6379
ZG_REDIS_PASSWORD=                   # from SSM/KMS — DO NOT commit
ZG_REDIS_DB=0

# --- Log (prod: structured JSON at info) ---
ZG_LOG_LEVEL=info
ZG_LOG_ENCODING=json

# --- JWT (prod: real ES256 ECDSA P-256 key, NEVER the DevKey) ---
# Mount the PEM as a secret and point ZG_JWT_KEY_FILE at it, OR set the path
# directly. Leave empty only if you inject ZG_JWT_KEY_FILE via env at runtime.
ZG_JWT_KEY_FILE=                     # path to mounted ES256 PEM, from secret manager
ZG_JWT_KEY_ID=                       # kid header for key rotation
ZG_JWT_SECRET=                       # legacy/dev only — NOT used for ES256 prod
ZG_JWT_ISSUER=zhanggui-junshi

# --- WeChat Mini Program (per-tenant; default pair env-injected) ---
ZG_WX_APP_ID=                        # from secret manager — DO NOT commit
ZG_WX_SECRET=                        # from secret manager — DO NOT commit
ZG_WX_CODE2SESSION_URL=              # empty -> official WeChat endpoint

# --- AI gateway (LLM providers, env-injected, never committed) ---
ZG_AI_DEFAULT_PROVIDER=              # e.g. doubao | deepseek | qwen
# Providers/routes are MAP fields — viper cannot fill maps from env, so config.go
# scans these directly (CONTRACT §19). Names/tiers are lower-cased into the maps.
# Per-provider keys: ZG_AI_PROVIDERS_<NAME>_<FIELD> (FIELD = BASE_URL | API_KEY | MODEL).
# Examples (fill from your provider console / secret manager):
#   ZG_AI_PROVIDERS_DOUBAO_BASE_URL=
#   ZG_AI_PROVIDERS_DOUBAO_API_KEY=      # from secret manager — DO NOT commit
#   ZG_AI_PROVIDERS_DOUBAO_MODEL=doubao-lite-32k
#   ZG_AI_PROVIDERS_DEEPSEEK_BASE_URL=
#   ZG_AI_PROVIDERS_DEEPSEEK_API_KEY=    # from secret manager — DO NOT commit
#   ZG_AI_PROVIDERS_DEEPSEEK_MODEL=deepseek-chat
# Per-tier route keys: ZG_AI_ROUTES_<TIER>_<FIELD> (TIER = LITE|V3|R1, FIELD = PROVIDER | MODEL).
#   ZG_AI_ROUTES_LITE_PROVIDER=doubao
#   ZG_AI_ROUTES_V3_PROVIDER=deepseek
#   ZG_AI_ROUTES_V3_MODEL=deepseek-chat

# --- WeChat Pay V3 (service-provider; real client when all fields present) ---
# When mch_id + api_v3_key + cert_serial + a private key are set, the wiring
# builds the REAL V3 client; otherwise it falls back to FakeWxPay (no network).
ZG_PAYMENT_MCH_ID=                   # 服务商商户号, from secret manager
ZG_PAYMENT_API_V3_KEY=               # APIv3 密钥 (32 bytes; AES-GCM), from secret manager — DO NOT commit
ZG_PAYMENT_CERT_SERIAL=              # 商户 API 证书序列号
ZG_PAYMENT_PRIVATE_KEY_FILE=         # path to mounted 商户 API 私钥 PEM (or use _PEM inline)
ZG_PAYMENT_PLATFORM_CERT_URL=        # empty -> official /v3/certificates
ZG_PAYMENT_NOTIFY_URL=               # 支付回调通知地址 (public URL)
ZG_PAYMENT_BASE_URL=                 # empty -> https://api.mch.weixin.qq.com

# --- Job queue (Redis Stream; worker binary + in-process producers) ---
ZG_JOBQUEUE_CONSUMER=worker-1        # unique per worker replica
# stream/group/block/max_len have safe built-in defaults (zg:jobs / zg-workers / 5s / 10000).

# --- Scheduler (where the pregen cron runs) ---
ZG_SCHEDULER_RUN_IN_API=false        # prod: cron binary owns pregen; dev sets true

# --- OpenTelemetry (prod: ON, TLS to collector, 10% sampling) ---
ZG_OTEL_ENABLE=true
ZG_OTEL_ENDPOINT=                    # OTLP collector host:port, from secret manager
ZG_OTEL_SERVICE_NAME=zhanggui-junshi-backend
ZG_OTEL_SAMPLE_RATIO=0.1
ZG_OTEL_INSECURE=false               # prod: TLS to the collector

# --- Tencent COS (prod object storage — replaces MinIO) ---
ZG_COS_SECRET_ID=                   # from SSM/KMS — DO NOT commit
ZG_COS_SECRET_KEY=                  # from SSM/KMS — DO NOT commit
ZG_COS_REGION=ap-guangzhou
ZG_COS_BUCKET=zhanggui-prod-1300000000
ZG_COS_ENDPOINT=

# --- Multitenancy (prod: strict on, mock header OFF — rely on JWT) ---
ZG_MULTITENANCY_STRICT=true
ZG_MULTITENANCY_DEV_MOCK_HEADER=false
ZG_MULTITENANCY_PLATFORM_TENANT_ID=1   # tenant hosting platform_ops (admin login)

# --- Migrate (one-shot profile; only needs DB) ---
ZG_MIGRATIONS_DIR=/app/migrations
